{
  "name": "rumbo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "La app de Rumbo: la página del evento, la credencial, el escáner y el panel.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copiar-despliegue.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:pg": "node scripts/test-pg.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:local": "node scripts/postgres-local.mjs",
    "setup:dev": "node scripts/setup-dev.mjs",
    "seed": "node scripts/seed.mjs",
    "e2e": "node scripts/e2e-testnet.mjs",
    "capturas": "node scripts/capturas.mjs",
    "informe": "node scripts/informe.mjs",
    "certificados": "node scripts/certificados.mjs",
    "paquete-embajadores": "node scripts/paquete-embajadores.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0",
    "@stellar/stellar-sdk": "17.4.0",
    "jsqr": "1.4.0",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
