# Rumbo, la app. Copiá este archivo a .env.local (o dejá que lo haga pnpm setup:dev).
# .env.local nunca se versiona: ahí viven las llaves del servidor.

# Solo la red de prueba de Stellar. Con otro valor la app no arranca.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Las cuentas del servidor en la red de prueba. Son las mismas que usa el despliegue del contrato
# (contracts/rumbo-pass): lo público queda en contracts/rumbo-pass/deploy/testnet.json, lo secreto acá.
# Si faltan, pnpm setup:dev las genera y las fondea con friendbot.
#   sponsor: paga las comisiones de red de todas las operaciones (la fuente de cada transacción).
#   gate: la puerta, firma los check-ins y los canjes. Si falta, hace de puerta la patrocinadora.
#   issuer: emite el USDC de prueba y le da saldo a cada cuenta nueva.
#   organizer y treasury: quien organiza el evento de muestra y la cuenta de Rumbo que recibe la comisión.
STELLAR_SPONSOR_SECRET=
STELLAR_GATE_SECRET=
STELLAR_ISSUER_SECRET=
STELLAR_ORGANIZER_SECRET=
STELLAR_TREASURY_SECRET=

# El USDC de prueba. Se lee del despliegue del contrato; esto es el respaldo si no está.
STELLAR_ASSET_CODE=USDC
STELLAR_ASSET_ISSUER=
STELLAR_ASSET_CONTRACT=
# Cuánto USDC de prueba recibe cada cuenta nueva.
RUMBO_INITIAL_TEST_USDC=100

# El contrato rumbo-pass por defecto. Si queda vacío se usan los del despliegue
# (contracts/rumbo-pass/deploy/testnet.json: uno gratis y uno pago).
RUMBO_CONTRACT_ID=

# Qué implementación usa cada servicio. Hoy solo existen las de desarrollo.
RUMBO_REPO=sqlite
RUMBO_ACCOUNTS=dev
RUMBO_MAILER=dev
# Dónde viven la base y los correos de desarrollo (relativo a la carpeta app).
RUMBO_DATA_DIR=./data

NEXT_PUBLIC_BASE_URL=http://localhost:3000
