# Rumbo, la app. Copiá este archivo a .env.local (o dejá que lo haga pnpm setup:dev).
# .env.local nunca se versiona: ahí viven las llaves del servidor.

# Solo la red de prueba de Stellar. Con otro valor la app no arranca.
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# Las cuentas del servidor en la red de prueba. Son las mismas que usa el despliegue del contrato
# (contracts/rumbo-pass): lo público queda en contracts/rumbo-pass/deploy/testnet.json, lo secreto acá.
# Si faltan, pnpm setup:dev las genera y las fondea con friendbot.
#   sponsor: paga las comisiones de red de todas las operaciones (la fuente de cada transacción).
#   gate: la puerta, firma los check-ins y los canjes. Si falta, hace de puerta la patrocinadora.
#   issuer: emite el USDC de prueba y le da saldo a cada cuenta nueva.
#   organizer y treasury: quien organiza el evento de muestra y la cuenta de Rumbo que recibe la comisión.
STELLAR_SPONSOR_SECRET=
STELLAR_GATE_SECRET=
STELLAR_ISSUER_SECRET=
STELLAR_ORGANIZER_SECRET=
STELLAR_TREASURY_SECRET=

# El USDC de prueba. Se lee del despliegue del contrato; esto es el respaldo si no está.
STELLAR_ASSET_CODE=USDC
STELLAR_ASSET_ISSUER=
STELLAR_ASSET_CONTRACT=
# Cuánto USDC de prueba recibe cada cuenta nueva.
RUMBO_INITIAL_TEST_USDC=100

# El contrato rumbo-pass por defecto. Si queda vacío se usan los del despliegue
# (contracts/rumbo-pass/deploy/testnet.json: uno gratis y uno pago).
RUMBO_CONTRACT_ID=

# Qué implementación usa cada servicio. Las cuentas: dev (el modo de prueba) o pollar. El correo, hoy, solo el de desarrollo.
# La base: sqlite (el archivo de RUMBO_DATA_DIR, para desarrollo y pruebas) o postgres (producción, en Supabase).
# pglite es el mismo Postgres en WASM dentro del proceso, para probar el motor sin servidor (RUMBO_PGLITE_DIR).
RUMBO_REPO=sqlite
# Con RUMBO_REPO=postgres: la cadena del pooler de Supabase en modo transacción (puerto 6543). Las migraciones de
# src/server/migrations-pg se aplican con pnpm db:migrate, que lee esta misma variable.
DATABASE_URL=
# Con RUMBO_REPO=postgres: 32 bytes al azar en base64. Cifra las llaves de los QR y las de las cuentas de prueba
# guardadas en la base. Se genera una vez y no se cambia. Sin ella la app no arranca.
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
RUMBO_DATA_KEY=
# Opcional: cuántas conexiones a Postgres abre cada instancia (cinco).
RUMBO_PG_POOL_MAX=
RUMBO_ACCOUNTS=dev
# Con RUMBO_ACCOUNTS=pollar y la clave publicable de la app de Pollar, quien se inscribe entra con Google o con su
# correo, y su credencial queda en su propia cuenta de Stellar, que custodia Pollar (ver README, "Entrar con Google").
# Sin la clave, queda el modo de prueba. La clave publicable va al navegador: no es secreta.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
# Los de la app de Pollar que no van al navegador. La inscripción no los usa: la prueba de que la cuenta es de la
# persona es su firma (SEP-53), que el servidor verifica solo.
POLLAR_APP_ID=
POLLAR_SECRET_KEY=
RUMBO_MAILER=dev
# Dónde viven la base y los correos de desarrollo (relativo a la carpeta app).
RUMBO_DATA_DIR=./data

# Los frenos contra quien prueba a la fuerza (códigos de puesto, inscripciones) cuentan por la IP de
# quien pide, y esa IP tiene que ponerla la plataforma: en Vercel se usa x-real-ip sin configurar nada.
# Detrás de otro proxy, el encabezado que ese proxy escribe (x-real-ip, o x-forwarded-for si agrega la
# IP al final). Vacío y fuera de Vercel, ningún encabezado es de fiar y todos los pedidos cuentan juntos.
RUMBO_TRUSTED_IP_HEADER=

# Quién puede armar eventos nuevos desde una plantilla (/admin/nuevo). Con una clave acá, el formulario la pide
# ("clave de la casa"). Vacía, crear eventos está abierto en desarrollo y cerrado en producción.
RUMBO_CREATE_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
